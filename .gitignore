#-------------------------
# Operating Specific Junk Files
#-------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride

# OS X Thumbnails
._*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux & Editors Swap
*~
*.swp
*.swo

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

#-------------------------
# Environment & Credential Files
#-------------------------
# These should never be under version control, as it poses a security risk.
.env
.env.*
*.env
.env.local
.env.production
.env.development
.env.testing
.env.backup
.vagrant
Vagrantfile

#-------------------------
# SSL / Certificates / Private Keys
#-------------------------
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.pkcs12
id_rsa
id_rsa*

#-------------------------
# Database Dumps & Data Storage
#-------------------------
*.sql
*.sqlite
*.sqlite3
*.db
*.db3
*.dump
*.rdb

#-------------------------
# Backup & Archive Files
#-------------------------
*.bak
*.backup
*.old
*.orig
*.patch
*.diff
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz
*.bz2

#-------------------------
# User Uploads & Public Media (PII)
#-------------------------
# Protect all dynamically uploaded user assets
public/assets/uploads/*
!public/assets/uploads/.htaccess
!public/assets/uploads/profile/
public/assets/uploads/profile/*
!public/assets/uploads/profile/default.png
!public/assets/uploads/profile/.gitkeep

#-------------------------
# Writable & Temporary Files
#-------------------------
graphify-out/
writable/cache/*
!writable/cache/index.html

writable/logs/*
!writable/logs/index.html

writable/session/*
!writable/session/index.html

writable/uploads/*
!writable/uploads/index.html

writable/debugbar/*
!writable/debugbar/index.html

# Generic Log Files
*.log
*.log.*
php_errors.log

#-------------------------
# User Guide Temp Files
#-------------------------
user_guide_src/build/*
user_guide_src/cilexer/build/*
user_guide_src/cilexer/dist/*
user_guide_src/cilexer/pycilexer.egg-info/*

#-------------------------
# Test Files
#-------------------------
tests/coverage*
phpunit

#-------------------------
# Composer & Node Dependencies
#-------------------------
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#-------------------------
# IDE / Development Files
#-------------------------
_modules/*
.php-version

# Jetbrains editors
.idea/
*.iml

# NetBeans
/nbproject/
/build/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel
/api/

# Visual Studio Code
.vscode/

/results/
