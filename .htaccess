# ----------------------------------------------------------------------
# EVIDENCE COMMAND CENTER (ECC) - ROOT SECURITY HARDENING (.htaccess)
# Melindungi file sistem, kredensial .env, & direktori internal di cPanel
# ----------------------------------------------------------------------

# 1. Matikan directory listing
Options -Indexes

# 2. Blokir akses langsung ke file sensitif (kredensial, konfigurasi, backup, skrip)
<FilesMatch "(^\.(env|git|cpanel|htaccess|htpasswd|user\.ini|DS_Store)|^(composer\.(json|lock)|spark|preload\.php|phpunit\.xml(\.dist)?)$|\.(env|sql|sqlite|sqlite3|db|log|bak|old|orig|zip|tar|gz|tgz|rar|7z|pem|key|crt|p12|sh|bash|md|yml|yaml|ini)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 3. Izinkan validasi sertifikat SSL otomatis cPanel (AutoSSL / Let's Encrypt)
    RewriteRule ^\.well-known/ - [L]

    # 4. Blokir akses langsung ke dotfiles & direktori internal non-publik
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule ^(app|system|tests|vendor|writable|docs|builds|sql_cpanel_parts|ECC\ 2\.0)(/|$) - [F,L,NC]

    # 5. Arahkan seluruh permintaan sah ke front-controller public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
