#--------------------------------------------------------------------
# Evidence Command Center (ECC) - Template Konfigurasi Production (.env)
# Salin ke .env di server cPanel dan isi nilai asli (JANGAN commit .env)
#--------------------------------------------------------------------

# WAJIB 'production' di server live (mematikan Debug Toolbar & stack trace)
CI_ENVIRONMENT = production

# URL dasar aplikasi (gunakan https:// pada server production)
app.baseURL = 'https://domain-production-anda/'
app.forceGlobalSecureRequests = true

# WAJIB diisi kunci acak 32-byte (buat dengan: php spark key:generate --show)
# Digunakan untuk menandatangani cookie remember_me & sesi survei
encryption.key = hex2bin:GANTI_DENGAN_64_KARAKTER_HEX_ACAK

# Keamanan Cookie (aktifkan true jika production menggunakan HTTPS)
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

# Konfigurasi Basis Data
database.default.hostname = localhost
database.default.database = NAMA_DATABASE
database.default.username = USER_DATABASE
database.default.password = KATA_SANDI_DATABASE
database.default.DBDriver = MySQLi
database.default.DBDebug = false
database.default.port = 3306
